# Ledgerly Environment Template

# Database Configuration
# Option A: Local SQLite (Leave blank or commented out)
# DATABASE_URL=

# Option B: Cloud PostgreSQL / Supabase Connection String
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Authentication
JWT_SECRET="change_this_to_a_secure_random_secret"
ADMIN_PASSWORD="change_this_to_a_secure_password"

# Server Port (Default: 3000)
PORT=3000
